<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Modemde otomatik port yönlendirme (UPnP keşfi çoklu yayın yanıtı bekler) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Telefon özellikleri (Sihirbaz → Genel): yalnızca açılınca ve kullanıcı izin verince kullanılır. -->
    <!-- Uygulama kilidi (parmak izi/yüz; normal izin, kullanıcıya sorulmaz). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- Uygulamanın kendini güncellemesi (her kurulumda kullanıcı onaylar) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.tailscale.ipn" />
        <!-- Otomasyon köprüsü: kurulu otomasyon uygulamaları (AutomationBridge.KNOWN_APPS; API 30+ paket görünürlüğü). -->
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="com.arlosoft.macrodroid" />
        <package android:name="com.llamalab.automate" />
    </queries>

    <!-- Yedek: Android 11 ve öncesinde allowBackup="false" bütün yedeği kapatır; 12+ için dataExtractionRules bulut yedeğini
         ve cihazdan cihaza aktarımı kapatır. Lint'in ayrıca istediği fullBackupContent bu yüzden gereksiz. -->
    <application
        android:name=".DroidServerApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_server"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:supportsRtl="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dil değişince uygulamayı yeniden açar; ayrı süreçte çalışır ki ana süreç kapanabilsin. -->
        <activity
            android:name=".ui.RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Play incelemesi için (İngilizce): docs/play-console.md'deki beyanla aynı. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Self-hosted server: an HTTP/API server the user runs on their own phone for their own apps and devices. It must keep answering requests from other devices while the screen is off; it runs only after the user starts it and shows a persistent notification with a stop action." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.UpdateReceiver"
            android:exported="false" />

        <!-- Onaylı SMS (bkz. SmsConfirm.kt): bildirimdeki Gönder SMS uygulamasını açar, Atla isteği düşürür. -->
        <activity
            android:name=".service.SmsSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".service.SmsSkipReceiver"
            android:exported="false" />

        <!-- Bildirim panelindeki hızlı ayar kutucuğu: sunucuyu aç/kapat. -->
        <service
            android:name=".service.ServerTileService"
            android:exported="true"
            android:icon="@drawable/ic_server"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Tasker/MacroDroid komutları: açık yayın ve gizli anahtar (bkz. AutomationBridge). Otomasyon uygulamaları
             izin tanımlayamadığı için yetki izinle değil, her komuttaki anahtarla denetlenir. -->
        <receiver
            android:name=".service.TaskerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.plyg.droidserver.action.START" />
                <action android:name="com.plyg.droidserver.action.STOP" />
                <action android:name="com.plyg.droidserver.action.DEPLOY" />
            </intent-filter>
        </receiver>

        <!-- Ana ekran widget'ı: durum, adres, istek ve pil. -->
        <receiver
            android:name=".service.StatusWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_widget" />
        </receiver>
        <!-- Ana ekran widget'ı: MQTT sahneleri (ilk dördü düğme). -->
        <receiver
            android:name=".service.SceneWidget"
            android:exported="false"
            android:label="@string/scene_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scene_widget" />
        </receiver>
    </application>
</manifest>
