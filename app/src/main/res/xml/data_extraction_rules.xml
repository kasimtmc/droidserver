<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+ hedef): allowBackup="false" cihazdan cihaza aktarımı engellemez. Sunucu verisi, sırlar ve
     anahtarlar ne buluta yedeklenir ne yeni cihaza taşınır; taşımak için uygulamanın kendi yedeği kullanılır. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
